{
  "name": "blockcolc",
  "version": "2.5.6",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "integration/*"
  ],
  "scripts": {
    "version:check": "node tools/sync-version.mjs --check",
    "version:sync": "node tools/sync-version.mjs --write",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:tools": "node --test tools/check-ui-assets.test.mjs tools/web-release-report.test.mjs tools/full-run-policy.test.mjs",
    "test:fast": "npm run version:check && npm run test:tools && npm run typecheck && npm test",
    "test:extended": "npm run test:extended -w @blockcolc/voxel",
    "test:unit:full": "npm run test:fast && npm run test:extended",
    "test:web:smoke": "npm run test:e2e:smoke -w @blockcolc/web",
    "test:web:diagnostics": "npm run test:e2e:diagnostics -w @blockcolc/web",
    "test:web:release": "npm run test:e2e:release -w @blockcolc/web --",
    "test:web:release:check": "npm run test:e2e:release:check -w @blockcolc/web",
    "test:e2e": "npm run test:e2e --workspaces --if-present"
  }
}
