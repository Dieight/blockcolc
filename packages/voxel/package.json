{
  "name": "@blockcolc/voxel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./blueprint": "./src/blueprint.ts",
    "./blueprint-model": "./src/blueprint-model.ts",
    "./local-blueprint-sources": "./src/local-blueprint-sources.ts",
    "./environment": "./src/environment.ts",
    "./astronomy": "./src/astronomy.ts",
    "./glass-material": "./src/glass-material.ts",
    "./world-color-adjustment": "./src/world-color-adjustment.ts",
    "./holiday-buildings": "./src/holiday-buildings.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"test/*.diagnostic.test.ts\" --exclude \"test/*.extended.test.ts\"",
    "test:extended": "vitest run extended --passWithNoTests --maxWorkers=1 --testTimeout=240000",
    "test:diagnostics": "vitest run diagnostic --passWithNoTests",
    "metrics:terrain": "vite-node tools/terrain-metrics.ts"
  },
  "dependencies": {
    "@blockcolc/resource-pack": "file:../resource-pack",
    "suncalc": "2.0.2",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/three": "^0.178.0",
    "fflate": "^0.8.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
