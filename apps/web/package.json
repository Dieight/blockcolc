{
  "name": "@blockcolc/web",
  "version": "2.5.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:assets": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude \"tests/**\"",
    "test:e2e": "node ../../tools/run-web-e2e.mjs",
    "test:e2e:release": "node ../../tools/run-web-e2e.mjs --release-suites",
    "test:e2e:release:check": "node ../../tools/run-web-e2e.mjs --release-suites-check",
    "test:e2e:smoke": "node ../../tools/run-web-e2e.mjs --grep @smoke --project=mobile-chromium --workers=2",
    "test:e2e:diagnostics": "node ../../tools/run-web-e2e.mjs --production --diagnostics --workers=1"
  },
  "dependencies": {
    "@blockcolc/application": "file:../../packages/application",
    "@blockcolc/domain": "file:../../packages/domain",
    "@blockcolc/litematic": "file:../../packages/litematic",
    "@blockcolc/platform-capacitor": "file:../../packages/platform-capacitor",
    "@blockcolc/resource-pack": "file:../../packages/resource-pack",
    "@blockcolc/resource-pack-indexeddb": "file:../../packages/resource-pack-indexeddb",
    "@blockcolc/storage-indexeddb": "file:../../packages/storage-indexeddb",
    "@blockcolc/voxel": "file:../../packages/voxel",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
