// ACES fit and sRGB OETF from Three.js (MIT; assets/licenses/three.txt).
float3 bcSourceACES(float3 color, float exposure) {
    const mat3 inputMat = mat3(float3(0.59719,0.07600,0.02840),float3(0.35458,0.90834,0.13383),float3(0.04823,0.01566,0.83777));
    const mat3 outputMat = mat3(float3(1.60475,-0.10208,-0.00327),float3(-0.53108,1.10813,-0.07276),float3(-0.07367,-0.00605,1.07602));
    color = inputMat * (color * exposure / 0.6);
    float3 a = color * (color + 0.0245786) - 0.000090537;
    float3 b = color * (0.983729 * color + 0.4329510) + 0.238081;
    return clamp(outputMat * (a / b), 0.0, 1.0);
}
float3 bcSourceOETF(float3 value) {
    return mix(pow(value, float3(0.41666)) * 1.055 - float3(0.055),
        value * 12.92, float3(lessThanEqual(value, float3(0.0031308))));
}
