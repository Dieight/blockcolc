<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material 3 1.3.1 makes this full-size dialog non-floating. Android's
         background-blur API requires a translucent, floating window. Its
         MATCH_PARENT size and edge-to-edge insets are still owned by M3. -->
    <style name="EdgeToEdgeFloatingDialogTheme" parent="android:Theme.DeviceDefault.Dialog">
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <item name="android:windowClipToOutline">false</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowElevation">0dp</item>
    </style>
</resources>
